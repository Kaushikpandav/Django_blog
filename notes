async def demo(request):

    async for student in profile.objects.all():
        print(student.name)

    await profile.objects.acreate(name="akash")
    await profile.objects.afilter(name="akash").delete()
    await profile.objects.aupdate(name="akash")

    await profile.objects.aget(name="akash").delete()
    await profile.objects.afilter(name="akash").delete()

    dell = await profile.objects.aget(name="akash")
    await dell.adelete()

    return HttpResponse("hello")



# 85. ASYNC middleware


from django.utils.decorators import sync_and_async_middleware, sync_only_middleware, async_only_middleware



# @sync_only_middleware - only sync middleware will execute, doesn't matter it's start with respective to sync or async

# @aysnc_only_middleware - only async middleware will execute, doesn't matter it's start with respective to sync or async

@sync_and_async_middleware
def my_middleware(get_response):
    print("one time initialization")

    if inspect.iscoroutinefunction(get_response):
        async def middleware(request):
            print("Before View")
            return await get_response(request)
            print("After View")
        return middleware
    else:
        def middleware(request):
            print("Before View")
            return get_response(request)
            print("After View")
        return middleware



class AsyncMiddleware:

    async_capable = True
    sync_capable = False

    def __init__(self, get_response):
        print("one time initialization")
        self.get_response = get_response
        if inspect.iscoroutinefunction(self.get_response):
            inspect.markcoroutinefunction(self)

    async def __call__(self, request):
        print("Before View")
        response = await self.get_response(request)
        print("After View")
        print(f"request path is : {request.path}")
        return response

class SyncMiddleware:

    async_capable = False
    sync_capable = True

    def __init__(self, get_response):
        print("one time initialization")
        self.get_response = get_response

    def __call__(self, request):
        print("Before View")
        response =  self.get_response(request)
        print("After View")
        print(f"request path is : {request.path}")
        return response

