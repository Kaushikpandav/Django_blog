            path('test/', RedirectView.as_view(url='https://www.google.com'), name='test'),
            path('test/', RedirectView.as_view(url='/'), name='test'),
            path('test/', RedirectView.as_view(pattern_name='test')), # patten_name will see name of matching url path and redirect there..
            path('profile/<int:pk>/', view.Testingview.as_view(pattern_name='test')),

            # in view.py

            class Testingview(RedirectView):
                # url = 'https://www.google.com' or
                # pattern_name = 'test' or
                # url = '/'
                # query_string = True # url with query string

                def get_redirect_url(self, *args, **kwargs):
                    kwargs['pk']==21
                    return super().get_redirect_url(*args, **kwargs)
            path('test/', Testingview.as_view(), name='test'),


